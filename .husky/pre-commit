#!/bin/sh

echo "🔍 Running pre-commit hook to check the code looks good... 🔍"

# Load NVM if available (useful for managing Node.js versions)
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"

# Ensure `pnpm` is available
echo "Checking if pnpm is available..."
if ! command -v pnpm >/dev/null 2>&1; then
    echo "❌ pnpm not found! Please ensure pnpm is installed and available in PATH."
    exit 1
fi

# Run typecheck
echo "Running typecheck..."
if ! pnpm typecheck; then
    echo "❌ Type checking failed! Please review TypeScript types."
    echo "Once you're done, don't forget to add your changes to the commit! 🚀"
    exit 1
fi

# Run lint
staged_app_files="$(git diff --cached --name-only --diff-filter=ACMR | grep -E '^app/.*\.(ts|tsx|js|jsx)$' || true)"

if [ -n "$staged_app_files" ]; then
    echo "Running lint on staged app files..."
    if ! printf '%s\n' "$staged_app_files" | tr '\n' '\0' | xargs -0 pnpm exec eslint --cache --cache-location ./node_modules/.cache/eslint; then
        echo "❌ Linting failed on staged app files! Run 'pnpm lint:fix' or fix the reported files manually."
        echo "Once you're done, don't forget to add your beautification to the commit! 🤩"
        exit 1
    fi
else
    echo "No staged app files to lint."
fi

echo "👍 All checks passed! Committing changes..."
